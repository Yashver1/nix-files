# --- Focus ---
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
# Cross to the neighboring monitor when there is no window in that direction.
alt - h : ~/.config/yabai/focus.sh west
alt - l : ~/.config/yabai/focus.sh east

# Left: landscape main monitor. Right: portrait monitor rotated 270 degrees.
hyper - a : yabai -m display --focus west
hyper - d : yabai -m display --focus east

# --- Modify Layout ---

# balance out tree 
hyper - e : yabai -m space --balance

# rotate layout clockwise
hyper - r : yabai -m space --rotate 270

# flip along y-axis
hyper - y : yabai -m space --mirror y-axis

# flip along x-axis
hyper - x : yabai -m space --mirror x-axis

# --- Moving Windows Around ---

# swap windows, crossing to the other monitor at the edge
shift + alt - j : ~/.config/yabai/move.sh south
shift + alt - k : ~/.config/yabai/move.sh north
shift + alt - h : ~/.config/yabai/move.sh west
shift + alt - l : ~/.config/yabai/move.sh east

# maximize a window
alt - f : yabai -m window --toggle zoom-fullscreen

# toggle window float
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# toggle window native fullscreen
shift + alt - f : yabai -m window --toggle native-fullscreen

# move window and split (warp)
ctrl + alt - j : yabai -m window --warp south
ctrl + alt - k : yabai -m window --warp north
ctrl + alt - h : yabai -m window --warp west
ctrl + alt - l : yabai -m window --warp east

# move window to display left and right
hyper - s : yabai -m window --display west && yabai -m display --focus west
hyper - g : yabai -m window --display east && yabai -m display --focus east

# move window to prev and next space
alt - p : yabai -m window --space prev
alt - n : yabai -m window --space next

# stop/start/restart yabai
ctrl + alt - q : yabai --stop-service
ctrl + alt - s : yabai --start-service
ctrl + alt - r : yabai --restart-service

# focus desktop
alt - 1 : ~/.config/yabai/focus_space.sh s1
alt - 2 : ~/.config/yabai/focus_space.sh s2
alt - 3 : ~/.config/yabai/focus_space.sh s3
alt - 4 : ~/.config/yabai/focus_space.sh s4
alt - 5 : ~/.config/yabai/focus_space.sh s5
alt - 6 : ~/.config/yabai/focus_space.sh s6
alt - 7 : ~/.config/yabai/focus_space.sh s7
alt - 8 : ~/.config/yabai/focus_space.sh s8

# cycle fullscreen apps
alt - 0 : yabai -m space --focus "$(yabai -m query --spaces | jq -r --argjson cur "$(yabai -m query --spaces --space | jq .index)" '[.[] | select(."is-native-fullscreen") | .index] as $fs | (([$fs[] | select(. > $cur)] + $fs)[0]) // empty')"

# send window to desktop and follow focus
shift + alt - 1 : yabai -m window --space s1; yabai -m space --focus s1
shift + alt - 2 : yabai -m window --space s2; yabai -m space --focus s2
shift + alt - 3 : yabai -m window --space s3; yabai -m space --focus s3
shift + alt - 4 : yabai -m window --space s4; yabai -m space --focus s4
shift + alt - 5 : yabai -m window --space s5; yabai -m space --focus s5
shift + alt - 6 : yabai -m window --space s6; yabai -m space --focus s6
shift + alt - 7 : yabai -m window --space s7; yabai -m space --focus s7
shift + alt - 8 : yabai -m window --space s8 && yabai -m space --focus s8

# resize
hyper - h : yabai -m window --resize left:-40:0
hyper - j : yabai -m window --resize bottom:0:40
hyper - k : yabai -m window --resize top:0:-40
hyper - l : yabai -m window --resize right:40:0
